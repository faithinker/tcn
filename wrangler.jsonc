{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tcn",
  // @astrojs/cloudflare v14 통합 엔트리포인트 (astro dev·프로덕션 배포 겸용)
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  // 정적 산출물(dist)을 ASSETS로 서빙. 빌드시 어댑터가 directory를 서버 기준 상대경로로 보정.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tcn-content",
      "database_id": "15252162-0f50-4f5a-ab1a-c4385a4cef3d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "tcn-media" }
  ]
}
