{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tcn",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  // 어댑터가 directory를 생성된 서버 출력 기준 상대 경로로 보정한다.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    // Canonical URLs are slashless. Keep Workers Static Assets from redirecting
    // prerendered `path/index.html` assets back to a trailing-slash URL.
    "html_handling": "drop-trailing-slash",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tcn-content",
      "database_id": "15252162-0f50-4f5a-ab1a-c4385a4cef3d",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tcn-media" }],
}
