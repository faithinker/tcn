{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tcn",
  // 요청은 어댑터 핸들러, 예약 실행(만료 기록 정리)은 src/worker.ts 가 처리한다.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  // 어댑터가 directory를 생성된 서버 출력 기준 상대 경로로 보정한다.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    // Canonical URLs are slashless. Keep Workers Static Assets from redirecting
    // prerendered `path/index.html` assets back to a trailing-slash URL.
    "html_handling": "drop-trailing-slash",
  },
  "observability": {
    "enabled": true,
  },
  // 매일 03:17 KST(UTC 18:17)에 보관 기간이 지난 접속기록·로그인 기록을 지운다.
  "triggers": { "crons": ["17 18 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tcn-content",
      "database_id": "15252162-0f50-4f5a-ab1a-c4385a4cef3d",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tcn-media" }],
}
