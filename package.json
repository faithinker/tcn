{
  "name": "tcn-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Transcultural Network (TCN)",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "content:export": "node scripts/export-public-content.mjs",
    "predev": "npm run content:export",
    "dev": "astro dev --host 0.0.0.0",
    "prestart": "npm run content:export",
    "start": "astro dev --host 0.0.0.0",
    "prebuild": "npm run content:export",
    "build": "astro build",
    "preview": "astro preview",
    "preview:mobile": "astro dev --host 0.0.0.0 --port 4341",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=low",
    "verify": "node scripts/verify.mjs",
    "verify:founding-media": "node scripts/verify-founding-media.mjs",
    "verify:seminar-carousel": "node scripts/verify-seminar-carousel.mjs",
    "verify:admin": "node scripts/verify-admin-authoring.mjs",
    "test:qna:d1": "node scripts/verify-qna-d1.mjs",
    "test:roles:d1": "node scripts/verify-roles-d1.mjs",
    "test:forum:d1": "node scripts/verify-forum-d1.mjs",
    "test:users:d1": "node scripts/verify-users-d1.mjs",
    "verify:forum-users": "node scripts/verify-forum-users.mjs",
    "verify:header": "node scripts/verify-header-navigation.mjs",
    "motion": "node scripts/motion.mjs",
    "a11y": "node scripts/a11y.mjs",
    "test": "vitest run --coverage",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "^7.0.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "astro": "^7.3.8",
    "marked": "^18.1.1",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tiptap-markdown": "^0.9.0",
    "wrangler": "^4.151.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.4",
    "chrome-launcher": "^1.2.2",
    "esbuild": "^0.28.2",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true
  }
}
