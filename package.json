{
  "name": "tcn-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Transcultural Network (TCN)",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "start": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview",
    "preview:mobile": "astro dev --host 0.0.0.0 --port 4341",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=low",
    "verify": "node scripts/verify.mjs",
    "verify:founding-media": "node scripts/verify-founding-media.mjs",
    "verify:seminar-carousel": "node scripts/verify-seminar-carousel.mjs",
    "verify:admin": "node scripts/verify-admin-authoring.mjs",
    "test:qna:d1": "node scripts/verify-qna-d1.mjs",
    "motion": "node scripts/motion.mjs",
    "a11y": "node scripts/a11y.mjs",
    "test": "vitest run --coverage",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/react": "^6.0.1",
    "@tiptap/core": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "astro": "^7.1.1",
    "marked": "^18.0.7",
    "pretendard": "^1.3.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tiptap-markdown": "^0.9.0",
    "wrangler": "^4.114.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "chrome-launcher": "^1.2.1",
    "esbuild": "^0.28.1",
    "lighthouse": "^13.4.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
