# 모든 정적 응답에 보안 헤더 기본값. 워커가 렌더하는 응답은 src/middleware.ts가 같은 값을 붙이고,
# src/lib/security-headers.ts의 SECURITY_HEADERS와 일치하는지 테스트가 확인한다. 둘을 함께 고친다.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# 해시 지문된 정적 자산(폰트·CSS·JS) → 1년 immutable 캐시(재방문 즉시 로드)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
