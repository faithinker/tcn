# L11: prefix 없는 기존 한국어 URL과 events 트리 은퇴 경로를 /ko/로 영구 이전.
# 구체 경로 먼저, 와일드카드 나중(위→아래 첫 매치 우선).
# 타깃은 canonical(디렉터리 포맷=trailing slash)에 바로 착지하도록 슬래시 부여.
/events/2025/founding-ceremony-invitation     /ko/about/founding/     301
/en/events/2025/founding-ceremony-invitation  /en/about/founding/  301
/en/events                                    /en/seminars/        301
/events                                       /ko/seminars/        301
/about/declaration                            /ko/about/declaration/ 301
/about/founding                               /ko/about/founding/    301
/about/bylaws                                 /ko/about/bylaws/      301
/about                                        /ko/about/             301
/people                                       /ko/people/            301
/seminars                                     /ko/seminars/          301
/contact                                      /ko/contact/           301

# 회차 번호가 canonical 식별자다. 기존 연도-지역 slug는 영구 별칭으로 유지한다.
/ko/seminars/2025-laos                        /ko/seminars/1/         301
/en/seminars/2025-laos                        /en/seminars/1/         301
/ko/seminars/2026-korea                       /ko/seminars/2/         301
/en/seminars/2026-korea                       /en/seminars/2/         301

/en/events/*                                  /en/seminars/          301
/events/*                                     /ko/seminars/          301
/about/*                                      /ko/about/:splat       301
/seminars/*                                   /ko/seminars/:splat    301
