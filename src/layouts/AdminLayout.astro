---
import '../styles/global.css';

interface Props {
  title?: string;
  user?: { username: string; displayName: string | null } | null;
}
const { title = 'Admin', user = null } = Astro.props;
// astro.config.mjs 의 site — 로컬에서 편집 중이어도 퀵링크는 항상 운영 사이트를 가리킨다.
const liveSiteUrl = (Astro.site ?? new URL('https://tcn.faithinker12.workers.dev')).href;
// 헤더 액션 공통 모양: 44px 타깃 + hover 배경/색 + 포인터 커서.
const headerAction =
  'inline-flex min-h-11 cursor-pointer items-center gap-1 px-3 font-bold text-link no-underline transition-colors hover:bg-canvas-band hover:text-link-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · TCN Admin</title>
    <style is:global>
      /* 어드민 본문 에디터(Tiptap) 내부 요소 — 공개 타입 램프가 아닌 편집기용 구조 스타일 */
      .admin-prose {
        font-family: inherit;
        line-height: 1.6;
      }
      .admin-prose h2 {
        font-size: 1.4em;
        font-weight: 600;
        margin: 0.9em 0 0.3em;
      }
      .admin-prose h3 {
        font-size: 1.15em;
        font-weight: 600;
        margin: 0.8em 0 0.3em;
      }
      .admin-prose p {
        margin: 0.5em 0;
      }
      .admin-prose ul {
        list-style: disc;
        padding-left: 1.4em;
        margin: 0.5em 0;
      }
      .admin-prose ol {
        list-style: decimal;
        padding-left: 1.4em;
        margin: 0.5em 0;
      }
      .admin-prose blockquote {
        border-left: 3px solid var(--color-hairline-strong);
        padding-left: 0.9em;
        color: var(--color-body-muted);
        margin: 0.6em 0;
      }
      .admin-prose a {
        color: var(--color-link);
        text-decoration: underline;
      }
      /* 게시 상태 모션 — 상태 전달용만. 체크는 그려지고, 배너는 4px 올라오며 나타난다. */
      @keyframes admin-check-draw {
        from {
          stroke-dashoffset: 26;
        }
        to {
          stroke-dashoffset: 0;
        }
      }
      @keyframes admin-banner-in {
        from {
          opacity: 0;
          transform: translateY(4px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      @keyframes admin-progress-sweep {
        from {
          transform: translateX(-100%);
        }
        to {
          transform: translateX(300%);
        }
      }
      .admin-check path {
        stroke-dasharray: 26;
        animation: admin-check-draw 450ms cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
      }
      .admin-banner {
        animation: admin-banner-in 200ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
      }
      .admin-progress {
        transition: width 200ms cubic-bezier(0.22, 0.61, 0.36, 1);
      }
      .admin-progress-sweep {
        animation: admin-progress-sweep 1100ms cubic-bezier(0.45, 0, 0.55, 1) infinite;
      }
      @media (prefers-reduced-motion: reduce) {
        .admin-check path {
          stroke-dasharray: none;
          animation: none;
        }
        .admin-banner,
        .admin-progress,
        .admin-progress-sweep {
          animation: none;
          transition: none;
        }
        .admin-progress-sweep {
          width: 100%;
        }
      }
      .admin-prose p.is-editor-empty:first-child::before {
        content: attr(data-placeholder);
        color: var(--color-body-muted);
        float: left;
        height: 0;
        pointer-events: none;
      }
    </style>
  </head>
  <body class="min-h-dvh bg-canvas font-sans text-body antialiased">
    {
      user && (
        <header class="border-b border-hairline bg-canvas">
          <div class="mx-auto flex max-w-[75rem] items-center justify-between px-4 py-3">
            <a href="/admin" class="font-sans text-body-sm font-bold tracking-tight text-ink">
              TCN Admin
            </a>
            <div class="flex items-center gap-2 text-caption">
              <a href={liveSiteUrl} target="_blank" rel="noopener" class={headerAction}>
                Live site<span aria-hidden="true">↗</span>
              </a>
              <span class="px-2 text-body-muted">{user.displayName ?? user.username}</span>
              <button id="admin-logout" type="button" class={headerAction}>
                Logout
              </button>
            </div>
          </div>
        </header>
      )
    }
    <script>
      document.getElementById('admin-logout')?.addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/admin/login';
      });
    </script>
    <main class="mx-auto max-w-[75rem] px-4 py-10">
      <slot />
    </main>
  </body>
</html>
