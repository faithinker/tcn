---
import '../styles/global.css';
import { getDB } from '../lib/db';
import { countAdminQuestions } from '../lib/qna/repository';

interface Props {
  title?: string;
  user?: { username: string; displayName: string | null } | null;
  waitingQuestionCount?: number;
}
const { title = 'Admin', user = null, waitingQuestionCount } = Astro.props;
const pathname = Astro.url.pathname;
const activeSection = pathname.startsWith('/admin/questions') ? 'questions' : 'posts';
const waitingCount =
  user === null ? 0 : (waitingQuestionCount ?? (await countAdminQuestions(getDB(), 'waiting')));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · TCN Admin</title>
    <style is:global>
      /* 어드민 본문 에디터(Tiptap) 내부 요소 — 공개 타입 램프가 아닌 편집기용 구조 스타일 */
      .admin-prose {
        font-family: inherit;
        line-height: 1.6;
      }
      .admin-prose h2 {
        font-size: 1.4em;
        font-weight: 600;
        margin: 0.9em 0 0.3em;
      }
      .admin-prose h3 {
        font-size: 1.15em;
        font-weight: 600;
        margin: 0.8em 0 0.3em;
      }
      .admin-prose p {
        margin: 0.5em 0;
      }
      .admin-prose ul {
        list-style: disc;
        padding-left: 1.4em;
        margin: 0.5em 0;
      }
      .admin-prose ol {
        list-style: decimal;
        padding-left: 1.4em;
        margin: 0.5em 0;
      }
      .admin-prose blockquote {
        border-left: 3px solid var(--color-hairline-strong);
        padding-left: 0.9em;
        color: var(--color-body-muted);
        margin: 0.6em 0;
      }
      .admin-prose a {
        color: var(--color-link);
        text-decoration: underline;
      }
      .admin-prose p.is-editor-empty:first-child::before {
        content: attr(data-placeholder);
        color: var(--color-body-muted);
        float: left;
        height: 0;
        pointer-events: none;
      }
      @media (max-width: 39.999rem) {
        .admin-main > section {
          padding-right: 0;
          padding-left: 0;
        }
      }
    </style>
  </head>
  <body class="min-h-dvh bg-canvas-soft font-sans text-body antialiased">
    {
      user && (
        <header class="border-b border-hairline bg-canvas">
          <div class="mx-auto flex max-w-[75rem] flex-wrap items-stretch px-5 sm:flex-nowrap sm:px-8">
            <a
              href="/admin"
              class="flex min-h-15 shrink-0 items-center font-serif text-lead font-bold tracking-tight text-ink no-underline sm:mr-12 sm:min-h-18"
            >
              TCN
              <span class="ml-2.5 font-sans text-caption font-bold tracking-wide text-body-muted uppercase">
                Admin
              </span>
            </a>

            <nav
              class="order-3 flex w-full items-stretch gap-6 border-t border-hairline font-sans sm:order-none sm:w-auto sm:gap-7 sm:border-t-0"
              aria-label="Admin sections"
            >
              <a
                href="/admin"
                class:list={[
                  'inline-flex min-h-13 items-center border-b-[3px] pt-[3px] text-body-sm font-bold no-underline sm:min-h-18',
                  activeSection === 'posts'
                    ? 'border-accent text-ink'
                    : 'border-transparent text-body-muted hover:text-link',
                ]}
                aria-current={activeSection === 'posts' ? 'page' : undefined}
              >
                Posts
              </a>
              <a
                href="/admin/questions"
                class:list={[
                  'inline-flex min-h-13 items-center gap-2 border-b-[3px] pt-[3px] text-body-sm font-bold no-underline sm:min-h-18',
                  activeSection === 'questions'
                    ? 'border-accent text-ink'
                    : 'border-transparent text-body-muted hover:text-link',
                ]}
                aria-current={activeSection === 'questions' ? 'page' : undefined}
              >
                Questions
                <span
                  id="admin-waiting-count"
                  class:list={[
                    'inline-flex min-h-6 min-w-6 items-center justify-center rounded-full px-1.5 text-caption font-bold',
                    activeSection === 'questions'
                      ? 'bg-accent text-on-primary'
                      : 'bg-canvas-band text-body-muted',
                  ]}
                >
                  {waitingCount}
                </span>
              </a>
            </nav>

            <div class="ml-auto flex min-h-15 items-center gap-5 font-sans text-caption sm:min-h-18">
              <span class="hidden text-body-muted md:inline">
                {user.displayName ?? user.username}
              </span>
              <button
                id="admin-logout"
                type="button"
                class="border-0 border-b border-hairline bg-transparent p-0 font-bold text-ink hover:border-accent hover:text-link"
              >
                Log out
              </button>
            </div>
          </div>
        </header>
      )
    }
    <script>
      document.getElementById('admin-logout')?.addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/admin/login';
      });
    </script>
    <main class="admin-main mx-auto max-w-[75rem] px-5 py-10 sm:px-8 sm:py-14">
      <slot />
    </main>
  </body>
</html>
