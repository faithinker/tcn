---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/ui';
import { canonicalPath } from '../lib/canonical-url';
import fontsCssUrl from '../styles/fonts.css?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og/tcn-default.png',
  type = 'website',
  noindex = false,
} = Astro.props;

const siteName = t('site.name');
const pageTitle = title && title !== siteName ? `${title} | ${siteName}` : siteName;
const socialTitle = siteName;
const desc = description ?? t('site.tagline');
const siteRoot = Astro.site ?? Astro.url;
const canonical = new URL(canonicalPath(Astro.url.pathname), siteRoot);
const socialImageURL = new URL(image, siteRoot);
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  alternateName: 'TCN',
  url: new URL('/', siteRoot).href,
  logo: new URL('/icon-512.png', siteRoot).href,
  description: t('site.tagline'),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      document.documentElement.classList.add('js');
      const savedTheme = localStorage.getItem('tcn_theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const isDark = savedTheme === 'dark' || (!savedTheme && prefersDark);
      document.documentElement.classList.toggle('dark', isDark);
      const themeMeta = document.querySelector('meta[name="theme-color"]');
      if (themeMeta) themeMeta.setAttribute('content', isDark ? '#181715' : '#ffffff');
    </script>
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Transcultural Network" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={socialImageURL} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationJsonLd)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only rounded-sm bg-ink px-4 py-2 font-sans font-bold text-on-primary focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100]"
    >
      {t('common.skipToContent')}
    </a>
    <Header />
    {
      /* tabindex=-1: 스킵링크 착지점. scroll-mt 는 sticky 헤더(73px)가 본문 상단을 덮지 않게 한다.
        영역 전체에 포커스링을 그리지 않는 표준 스킵 타깃 처리로 outline 만 숨긴다. */
    }
    <main id="main" tabindex="-1" class="scroll-mt-24 focus:outline-none">
      <slot />
    </main>
    <Footer />
    <link rel="stylesheet" href={fontsCssUrl} />
    <script>
      import '../scripts/reveal.ts';
    </script>
  </body>
</html>
