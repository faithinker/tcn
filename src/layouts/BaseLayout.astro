---
// L4: 공통 셸 — head/meta, 스킵링크, Header, main, Footer. 단일 밝은 테마(ThemeToggle 없음).
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
// perf: 마스트헤드·히어로("초문화네트워크 / Transcultural Network") 글리프를 담은
// 폰트 @font-face 번들(수백 KB)은 렌더를 막지 않도록 별도 CSS로 비차단 로드.
// media="print" → onload에서 all로 전환(표준 async CSS 패턴), noscript 폴백 제공.
// (영어 단일 전환으로 Noto Serif KR preload는 제거 — 글 본문에 한글이 있으면
//  fonts.css의 unicode-range 서브셋이 필요분만 지연 로드한다.)
import fontsCssUrl from '../styles/fonts.css?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og/tcn-default.png',
  type = 'website',
  noindex = false,
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const siteName = t('site.name');
const pageTitle = title && title !== siteName ? `${title} | ${siteName}` : siteName;
const socialTitle = siteName;
const desc = description ?? t('site.tagline');
const siteRoot = Astro.site ?? Astro.url;
// 영어 단일 사이트 — hreflang 대안 없음, canonical만 유지(디렉터리 포맷).
const canonical = new URL(Astro.url.pathname, siteRoot);
const socialImageURL = new URL(image, siteRoot);
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  alternateName: 'TCN',
  url: new URL('/', siteRoot).href,
  logo: new URL('/icon-512.png', siteRoot).href,
  description: t('site.tagline'),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      document.documentElement.classList.add('js');
      const savedTheme = localStorage.getItem('tcn_theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const isDark = savedTheme === 'dark' || (!savedTheme && prefersDark);
      document.documentElement.classList.toggle('dark', isDark);
      const themeMeta = document.querySelector('meta[name="theme-color"]');
      if (themeMeta) themeMeta.setAttribute('content', isDark ? '#181715' : '#ffffff');
    </script>
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Transcultural Network" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={socialImageURL} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationJsonLd)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only rounded-sm bg-ink px-4 py-2 font-sans font-bold text-on-primary focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100]"
    >
      {t('common.skipToContent')}
    </a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <!-- 폰트 @font-face 번들: body 끝 로드 — 뒤 콘텐츠 없어 첫 페인트 비차단.
         텍스트는 폴백으로 즉시 그려지고 크리티컬 서브셋은 head preload가 조기 확보. -->
    <link rel="stylesheet" href={fontsCssUrl} />
    <script>
      import '../scripts/reveal.ts';
    </script>
  </body>
</html>
