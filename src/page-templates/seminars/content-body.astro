---
import type { BodyDocument, ContentImage } from '../../lib/content';
import ContentInline from './content-inline.astro';

interface Props {
  document: BodyDocument;
  excludeImageSrc?: string;
}

const { document, excludeImageSrc } = Astro.props as Props;
const fileSize = (bytes: number) => bytes < 1024 * 1024
  ? `${Math.max(1, Math.round(bytes / 1024))} KB`
  : `${(bytes / 1024 / 1024).toFixed(1)} MB`;
const imageClass = (image: ContentImage) => image.layout === 'wide'
  ? 'mx-auto max-w-[75rem]'
  : 'max-w-[48rem]';
---

<div class="space-y-7">
  {document.content.map((block) => {
    if (block.type === 'paragraph') {
      return <p class="font-serif text-body-serif text-body"><ContentInline nodes={block.content} /></p>;
    }
    if (block.type === 'heading') {
      return block.attrs.level === 2
        ? <h2 class="!mt-14 font-serif text-display-md font-semibold text-ink sm:text-display-lg"><ContentInline nodes={block.content} /></h2>
        : <h3 class="!mt-10 font-serif text-display-sm font-semibold text-ink"><ContentInline nodes={block.content} /></h3>;
    }
    if (block.type === 'blockquote') {
      return (
        <blockquote class="!my-12 border-y-2 border-accent py-8 sm:!my-16 sm:py-10">
          {block.content.map((paragraph) => (
            <p class="font-serif text-display-sm font-semibold leading-relaxed text-ink">
              <ContentInline nodes={paragraph.content} />
            </p>
          ))}
        </blockquote>
      );
    }
    if (block.type === 'bulletList' || block.type === 'orderedList') {
      const Tag = block.type === 'orderedList' ? 'ol' : 'ul';
      return (
        <Tag class:list={[
          'space-y-3 pl-6 font-serif text-body-serif text-body',
          block.type === 'orderedList' ? 'list-decimal' : 'list-disc',
        ]}>
          {block.content.map((item) => (
            <li class="pl-1">
              {item.content.map((paragraph) => <p><ContentInline nodes={paragraph.content} /></p>)}
            </li>
          ))}
        </Tag>
      );
    }
    if (block.type === 'programme') {
      return (
        <ol class="!my-10 border-t border-hairline-strong">
          {block.attrs.items.map((item) => (
            <li class="grid gap-2 border-b border-hairline py-6 sm:grid-cols-[5rem_minmax(0,1fr)] sm:gap-6">
              <p class="font-sans text-body-sm font-bold text-accent">{item.time}</p>
              <div>
                <h3 class="font-serif text-display-sm font-semibold text-ink">{item.title}</h3>
                {item.description && <p class="mt-2 font-serif text-body-serif text-body">{item.description}</p>}
              </div>
            </li>
          ))}
        </ol>
      );
    }
    if (block.type === 'outcomes') {
      return (
        <ol class="!my-10 border-t-2 border-hairline-strong">
          {block.attrs.items.map((item, index) => (
            <li class="grid gap-3 border-b border-hairline py-6 sm:grid-cols-[2.5rem_minmax(0,1fr)] sm:gap-5">
              <span class="font-sans text-body-sm font-bold text-accent">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="font-serif text-display-sm font-semibold text-ink">{item.title}</h3>
                {item.description && <p class="mt-2 font-serif text-body-serif text-body">{item.description}</p>}
              </div>
            </li>
          ))}
        </ol>
      );
    }
    if (block.type === 'image') {
      return block.attrs.src && (
        <figure class:list={['!my-10', imageClass(block.attrs)]}>
          <img
            src={block.attrs.src}
            alt={block.attrs.alt}
            width={block.attrs.width}
            height={block.attrs.height}
            loading="lazy"
            decoding="async"
            class="h-auto w-full bg-canvas-band"
          />
          {block.attrs.caption && <figcaption class="mt-3 font-sans text-caption text-body-muted">{block.attrs.caption}</figcaption>}
        </figure>
      );
    }
    if (block.type === 'gallery') {
      return (
        <div class="!my-10 grid gap-8 sm:grid-cols-2">
          {block.attrs.images.filter((image) => image.src && image.src !== excludeImageSrc).map((image) => (
            <figure>
              <img
                src={image.src}
                alt={image.alt}
                width={image.width}
                height={image.height}
                loading="lazy"
                decoding="async"
                class="h-auto w-full bg-canvas-band"
              />
              {image.caption && <figcaption class="mt-3 font-sans text-caption text-body-muted">{image.caption}</figcaption>}
            </figure>
          ))}
        </div>
      );
    }
    if (block.type === 'attachments') {
      return (
        <section class="!my-10 bg-canvas-band p-5 sm:p-8" aria-label="Related materials">
          <ul class="space-y-3 font-sans text-body-sans">
            {block.attrs.files.map((item) => (
              <li class="border-t border-hairline pt-3 first:border-0 first:pt-0">
                {item.url ? (
                  <a
                    href={item.url}
                    target={item.mimeType === 'application/pdf' ? '_blank' : undefined}
                    rel={item.mimeType === 'application/pdf' ? 'noopener' : undefined}
                    download={item.mimeType === 'application/pdf' ? undefined : item.name}
                    class="font-bold text-link underline hover:text-link-hover"
                  >{item.label ?? item.name}</a>
                ) : <span class="font-bold text-ink">{item.label ?? item.name}</span>}
                <span class="ml-2 text-caption text-body-muted">{item.name} · {fileSize(item.size)}</span>
              </li>
            ))}
          </ul>
        </section>
      );
    }
    return block.type === 'horizontalRule' ? <hr class="!my-12 border-0 border-t border-hairline-strong" /> : null;
  })}
</div>
