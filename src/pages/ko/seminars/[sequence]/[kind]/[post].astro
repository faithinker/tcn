---
import { createPostRouteEntries, loadPublicContentFromEnvironment, postPath } from '../../../../../lib/content';

export async function getStaticPaths() {
  const content = await loadPublicContentFromEnvironment(import.meta.env);
  return createPostRouteEntries(content, 'ko');
}

const { post, seminar } = Astro.props;
return Astro.redirect(postPath('ko', post.seminarSequence, post.kind, post.postNo, post.slug), 301);
---
