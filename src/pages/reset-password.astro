---
export const prerender = false;
import AccountShell from '../components/membership/AccountShell.astro';
import PasswordField from '../components/membership/PasswordField.astro';
import { memberFeaturesEnabled, memberFeatureUnavailable } from '../lib/member-features';
if (!memberFeaturesEnabled()) return memberFeatureUnavailable();
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---

<AccountShell
  title="Choose a new password"
  description="Set a new password, then sign in again on the devices you use."
>
  <nav slot="navigation" aria-label="Account navigation">
    <a href="/login">Back to sign in</a>
    <a href="/forgot-password">Request another reset link</a>
  </nav>
  <section class="account-section">
    <h2>New sign-in details</h2>
    <p class="account-lead">Your other sessions will end when the password is updated.</p>
    <form
      id="recovery-form"
      class="account-form"
      method="post"
      action="/api/auth/reset-password"
      data-mode="reset"
    >
      <PasswordField
        id="reset-password"
        name="password"
        label="New password"
        isNew
        help="Use 15–64 characters. A long phrase is welcome; a symbol is not required."
      />
      <PasswordField
        id="reset-password-confirmation"
        name="passwordConfirmation"
        label="Confirm new password"
      />
      <p data-form-error class="account-error" role="alert" tabindex="-1" hidden></p>
      <button class="account-button" type="submit">
        Set new password
      </button>
    </form>
  </section>
  <script>
    import '../scripts/recovery';
  </script>
</AccountShell>
