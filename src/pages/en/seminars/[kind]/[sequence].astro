---
import SeminarPostDetail from '../../../../page-templates/seminars/post-detail.astro';
import { createPostRouteEntries, loadPublicContentFromEnvironment } from '../../../../lib/content';

export async function getStaticPaths() {
  const content = await loadPublicContentFromEnvironment(import.meta.env);
  return createPostRouteEntries(content, 'en').map((entry) => ({
    params: { kind: 'activities', sequence: String(entry.props.seminar.sequence) },
    props: entry.props,
  }));
}

const { post, seminar } = Astro.props;
---

<SeminarPostDetail post={post} seminar={seminar} />
