---
// D1 community post public detail (SSR). Soft-deleted/missing → 404.
import CommunityPost from '../../../../page-templates/seminars/community-post.astro';
import { getDB, getPost, listMediaForPost } from '../../../../lib/db';

export const prerender = false;

const db = getDB();
const post = await getPost(db, Astro.params.id ?? '');
if (!post) return new Response(null, { status: 404 });
const media = await listMediaForPost(db, post.id);
---

<CommunityPost post={post} media={media} />
