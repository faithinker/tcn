---
// Legacy UUID URL. Keep existing bookmarks valid while the public URL uses event_date.
import { getDB, getPost } from '../../../lib/db';
import { seminarHref } from '../../../lib/seminars';

export const prerender = false;

const post = await getPost(getDB(), Astro.params.id ?? '');
if (!post) return new Response(null, { status: 404 });
const destination = seminarHref(post.eventDate);
if (!destination) return new Response(null, { status: 404 });
return Astro.redirect(destination, 301);
---
