---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="Page not found"
  description="The requested Transcultural Network page could not be found."
  noindex
>
  <section class="bg-canvas px-5 py-24 sm:py-32">
    <div class="mx-auto max-w-[75rem]">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 font-serif text-display-lg font-semibold text-ink sm:text-display-hero">
        Page not found
      </h1>
      <p class="mt-6 max-w-[62ch] font-serif text-lead text-body">
        The address may have changed, or the page has not been published yet.
      </p>
      <div class="mt-8">
        <Button href="/" variant="primary">Back to home</Button>
      </div>
    </div>
  </section>
</BaseLayout>
