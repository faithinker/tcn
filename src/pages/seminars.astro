---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTile from '../components/SectionTile.astro';
import { content } from '../i18n/content';
import { formatDate } from '../i18n/utils';
import { getPublicSeminars } from '../lib/public-content/snapshot';

// 정적 에셋으로 나간다. 목록은 빌드 직전 D1 스냅샷이고 refresh-static-content 워크플로가 갱신한다.
// 상세(/seminars/<date>)는 발행·삭제가 즉시 반영돼야 해서 SSR로 둔다.
export const prerender = true;

const copy = content.seminars;

const { snapshot, collection } = await getPublicSeminars();
const next = collection.next;
const rest = collection.upcoming.slice(1);
const past = collection.past;
// 'empty'는 콘텐츠를 읽지 못한 빌드(운영 배포는 이 상태로 빌드되지 않는다).
const loadFailed = snapshot.source === 'empty';
---

<BaseLayout title={copy.title} description={copy.description}>
  <section class="bg-canvas px-5 pt-12 pb-8 sm:pt-24 sm:pb-14">
    <div class="mx-auto max-w-[75rem]">
      <h1 class="font-serif text-display-lg font-semibold text-ink sm:text-display-hero">
        {copy.heroTitle}
      </h1>
      <p class="mt-6 max-w-[62ch] font-serif text-lead text-body">{copy.heroBody}</p>
    </div>
  </section>

  {next && (
    <section class="bg-canvas px-5 pb-16 sm:pb-20">
      <div class="mx-auto max-w-[75rem]">
        <a
          href={next.href}
          class="group block border-y-2 border-accent bg-canvas-soft p-5 no-underline sm:p-10"
        >
          <div class="flex flex-wrap items-center gap-3">
            <span class="inline-flex items-center rounded-sm bg-accent px-2 py-0.5 font-sans text-caption font-bold uppercase text-on-primary">
              {next.status === 'today' ? copy.todayBadge : copy.upcomingBadge}
            </span>
          </div>
          <p class="mt-5 font-serif text-display-lg font-semibold leading-none text-ink sm:text-display-hero">
            {formatDate(next.eventDate)}
          </p>
          <p class="mt-4 font-serif text-display-sm font-semibold text-ink">{next.ordinalLabel}</p>
          <p class="mt-2 font-sans text-body-sans text-body-muted">
            {[
              next.title !== next.ordinalLabel ? next.title : null,
              next.address,
              next.summary ?? copy.details,
            ]
              .filter(Boolean)
              .join(' · ')}
          </p>
          <span class="mt-6 inline-flex min-h-[44px] items-center font-sans text-body-sans font-bold text-link no-underline group-hover:text-link-hover group-hover:underline">
            {copy.viewDetail} →
          </span>
        </a>
      </div>
    </section>
  )}

  {/* "Upcoming" 아이브로우는 바로 위 섹션의 "Upcoming Seminar" 와 자기 제목
      "Upcoming Seminars" 를 세 번째로 반복하므로 제목만 남긴다. */}
  {(rest.length > 0 || !next) && (
    <SectionTile variant="canvas" title={copy.upcomingTitle}>
      <div class="mt-8 grid gap-4">
        {rest.length ? (
          rest.map((post) => (
            <a href={post.href} class="group block bg-canvas p-5 no-underline sm:p-8">
              <p class="font-sans text-caption font-bold tabular-nums text-body-muted">
                {formatDate(post.eventDate)}
              </p>
              <h2 class="mt-2 font-serif text-display-sm font-semibold text-ink group-hover:text-link">
                {post.ordinalLabel}
              </h2>
              {post.title !== post.ordinalLabel && (
                <p class="mt-2 font-serif text-body-serif text-body">{post.title}</p>
              )}
              {post.address && (
                <p class="mt-3 font-sans text-body-sans text-body-muted">{post.address}</p>
              )}
              <span class="mt-4 inline-flex items-center font-sans text-body-sm font-bold text-link no-underline group-hover:underline">
                {copy.viewDetail} →
              </span>
            </a>
          ))
        ) : (
          <p class="font-serif text-body-serif text-body">
            {loadFailed ? copy.loadError : copy.empty}
          </p>
        )}
      </div>
    </SectionTile>
  )}

  <SectionTile variant="canvas" title={copy.pastTitle}>
    <div class="mt-8 grid gap-4">
      {past.length ? (
        past.map((post) => (
          <a href={post.href} class="group block border-t border-hairline py-7 no-underline">
            {post.eventDate && (
              <p class="font-sans text-caption font-bold tabular-nums text-body-muted">
                {formatDate(post.eventDate)}
              </p>
            )}
            <h2 class="mt-2 font-serif text-display-sm font-semibold text-ink group-hover:text-link">
              {post.ordinalLabel}
            </h2>
            {post.title !== post.ordinalLabel && (
              <p class="mt-2 font-serif text-body-serif text-body">{post.title}</p>
            )}
            {(post.summary || post.address) && (
              <p class="mt-3 font-sans text-body-sans text-body-muted">
                {post.summary ?? post.address}
              </p>
            )}
            <span class="mt-4 inline-flex items-center font-sans text-body-sm font-bold text-link no-underline group-hover:underline">
              {copy.viewDetail} →
            </span>
          </a>
        ))
      ) : (
        <p class="font-serif text-body-serif text-body">
          {loadFailed ? copy.loadError : copy.empty}
        </p>
      )}
    </div>
  </SectionTile>
</BaseLayout>
