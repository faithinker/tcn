---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTile from '../components/SectionTile.astro';
import { content } from '../i18n/content';
import { formatDate } from '../i18n/utils';
import { getDB } from '../lib/db';
import { getSeminarCollection, type SeminarView } from '../lib/seminars';

// SSR so the D1 community-post list stays live (no static prerender).
export const prerender = false;

const copy = content.seminars;

let next: SeminarView | null = null;
let rest: SeminarView[] = [];
let past: SeminarView[] = [];
let loadFailed = false;
try {
  const seminars = await getSeminarCollection(getDB());
  next = seminars.next;
  rest = seminars.upcoming.slice(1);
  past = seminars.past;
} catch {
  loadFailed = true;
}
---

<BaseLayout title={copy.title} description={copy.description}>
  <section class="bg-canvas px-5 pt-12 pb-8 sm:pt-24 sm:pb-14">
    <div class="mx-auto max-w-[75rem]">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 class="mt-3 font-serif text-display-lg font-semibold text-ink sm:text-display-hero">
        {copy.heroTitle}
      </h1>
      <p class="mt-6 max-w-[62ch] font-serif text-lead text-body">{copy.heroBody}</p>
    </div>
  </section>

  {
    next && (
      <section class="bg-canvas px-5 pb-16 sm:pb-20">
        <div class="mx-auto max-w-[75rem]">
          <a
            href={next.href}
            class="group block border-y-2 border-accent bg-canvas-soft p-5 no-underline sm:p-10"
          >
            <div class="flex flex-wrap items-center gap-3">
              <p class="eyebrow !mb-0">{copy.nextEyebrow}</p>
              <span class="inline-flex items-center rounded-sm bg-accent px-2 py-0.5 font-sans text-caption font-bold uppercase text-on-primary">
                {next.status === 'today' ? copy.todayBadge : copy.upcomingBadge}
              </span>
            </div>
            <p class="mt-5 font-serif text-display-lg font-semibold leading-none text-ink sm:text-display-hero">
              {formatDate(next.eventDate)}
            </p>
            <p class="mt-4 font-serif text-display-sm font-semibold text-ink">
              {next.ordinalLabel}
            </p>
            <p class="mt-2 font-sans text-body-sans text-body-muted">
              {[
                next.title !== next.ordinalLabel ? next.title : null,
                next.address,
                next.summary ?? copy.details,
              ]
                .filter(Boolean)
                .join(' · ')}
            </p>
            <span class="mt-6 inline-flex min-h-[44px] items-center font-sans text-body-sans font-bold text-link underline group-hover:text-link-hover">
              {copy.viewDetail} →
            </span>
          </a>
        </div>
      </section>
    )
  }

  {
    (rest.length > 0 || !next) && (
      <SectionTile variant="band" eyebrow={copy.upcomingEyebrow} title={copy.upcomingTitle}>
        <div class="mt-8 grid gap-4">
          {rest.length ? (
            rest.map((post) => (
              <a
                href={post.href}
                class="group block border-y border-hairline-strong bg-canvas p-5 no-underline sm:p-8"
              >
                <p class="font-sans text-caption font-bold uppercase text-accent">
                  {formatDate(post.eventDate)}
                </p>
                <h2 class="mt-2 font-serif text-display-sm font-semibold text-ink group-hover:text-link">
                  {post.ordinalLabel}
                </h2>
                {post.title !== post.ordinalLabel && (
                  <p class="mt-2 font-serif text-body-serif text-body">{post.title}</p>
                )}
                {post.address && (
                  <p class="mt-3 font-sans text-body-sans text-body-muted">{post.address}</p>
                )}
                <span class="mt-4 inline-flex items-center font-sans text-body-sm font-bold text-link underline">
                  {copy.viewDetail} →
                </span>
              </a>
            ))
          ) : (
            <p class="font-serif text-body-serif text-body">
              {loadFailed ? copy.loadError : copy.empty}
            </p>
          )}
        </div>
      </SectionTile>
    )
  }

  <SectionTile variant="canvas" eyebrow={copy.pastEyebrow} title={copy.pastTitle}>
    <div class="mt-8 grid gap-4">
      {
        past.length ? (
          past.map((post) => (
            <a href={post.href} class="group block border-t border-hairline py-7 no-underline">
              {post.eventDate && (
                <p class="font-sans text-caption font-bold uppercase text-accent">
                  {formatDate(post.eventDate)}
                </p>
              )}
              <h2 class="mt-2 font-serif text-display-sm font-semibold text-ink group-hover:text-link">
                {post.ordinalLabel}
              </h2>
              {post.title !== post.ordinalLabel && (
                <p class="mt-2 font-serif text-body-serif text-body">{post.title}</p>
              )}
              {(post.summary || post.address) && (
                <p class="mt-3 font-sans text-body-sans text-body-muted">
                  {post.summary ?? post.address}
                </p>
              )}
              <span class="mt-4 inline-flex items-center font-sans text-body-sm font-bold text-link underline">
                {copy.viewDetail} →
              </span>
            </a>
          ))
        ) : (
          <p class="font-serif text-body-serif text-body">
            {loadFailed ? copy.loadError : copy.empty}
          </p>
        )
      }
    </div>
  </SectionTile>
</BaseLayout>
