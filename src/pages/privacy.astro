---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackToTop from '../components/BackToTop.astro';
import { Content, getHeadings } from '../data/privacy-policy.ko.md';
import { t } from '../i18n/ui';

const sections = getHeadings().filter((heading) => heading.depth === 2);
---

<BaseLayout
  title="개인정보 처리방침"
  description="초문화네트워크(TCN)가 개인정보를 어떻게 처리하고 보호하는지 안내합니다."
>
  <section class="bg-canvas px-5 py-12 sm:py-24">
    <div class="mx-auto max-w-[75rem]">
      <p class="max-w-[74ch] font-sans text-body-sm text-body-muted" lang="en">
        This is the Korean-language privacy policy required under the Personal Information
        Protection Act of the Republic of Korea. An English translation is not yet available.
      </p>

      <div class="mt-8 grid gap-10 lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-14">
        <aside>
          <nav
            aria-label="목차"
            lang="ko"
            class="border-l-2 border-hairline-strong pl-5 font-sans lg:sticky lg:top-24"
          >
            <h2 class="font-sans text-caption font-bold text-ink">목차</h2>
            <ul class="mt-3 grid list-none gap-1 p-0">
              {sections.map((section) => (
                <li>
                  <a
                    href={`#${section.slug}`}
                    class="flex min-h-[44px] items-center break-keep rounded-sm px-2 text-body-sm font-bold text-ink no-underline hover:bg-canvas-soft"
                  >
                    {section.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>

        <article class="policy max-w-[74ch]" lang="ko">
          <Content />
        </article>
      </div>
    </div>
  </section>

  <BackToTop label={t('common.backToTop')} />
</BaseLayout>

<style>
  .policy {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--color-body);
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  .policy :global(h1) {
    font-family: var(--font-serif);
    font-size: clamp(1.875rem, 4vw, 2.5rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-ink);
    margin: 0 0 1.5rem;
  }

  .policy :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-ink);
    margin: 3rem 0 1rem;
    padding-top: 1rem;
    border-top: 2px solid var(--color-hairline-strong);
    scroll-margin-top: 6rem;
  }

  .policy :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 2rem 0 0.75rem;
  }

  .policy :global(p) {
    margin: 0 0 1rem;
  }

  .policy :global(ul),
  .policy :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }

  .policy :global(ul) {
    list-style: disc;
  }

  .policy :global(ol) {
    list-style: decimal;
  }

  .policy :global(li) {
    margin: 0.25rem 0;
  }

  .policy :global(li::marker) {
    color: var(--color-body-muted);
    font-family: var(--font-sans);
    font-weight: 700;
  }

  .policy :global(a) {
    color: var(--color-link);
    text-decoration: underline;
  }

  .policy :global(a:hover) {
    color: var(--color-link-hover);
  }

  .policy :global(code) {
    font-family: var(--font-sans);
    font-size: 0.9em;
    padding: 0.05em 0.35em;
    border-radius: 0.2rem;
    background: var(--color-canvas-soft);
    color: var(--color-ink);
  }

  .policy :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 1.5rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .policy :global(th),
  .policy :global(td) {
    border: 1px solid var(--color-hairline);
    padding: 0.65rem 0.85rem;
    text-align: left;
    vertical-align: top;
  }

  .policy :global(th) {
    background: var(--color-canvas-soft);
    color: var(--color-ink);
    font-weight: 700;
  }

  .policy :global(td:first-child) {
    width: 34%;
    color: var(--color-ink);
    font-weight: 600;
  }
</style>
