---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PostEditor from '../../../components/admin/PostEditor';
import {
  createCsrfToken,
  getSessionSecret,
  readSessionToken,
  requireOfficerPage,
} from '../../../lib/auth';
import { getDB } from '../../../lib/db';
import { getSeminarCollection } from '../../../lib/seminars/service';

const guard = await requireOfficerPage(Astro);
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex');
if (!guard.ok) return guard.response;
const { user } = guard;

const sessionToken = readSessionToken(Astro.request);
if (!sessionToken) return Astro.redirect('/admin/login');
const csrfToken = await createCsrfToken('posts', sessionToken, getSessionSecret());

const seminars = await getSeminarCollection(getDB());
const seminarSequence = seminars.chronological.length + 1;
---

<AdminLayout title="New post" user={user}>
  <div class="mb-6 flex items-center justify-between">
    <h1 class="font-serif text-display-sm font-semibold text-ink">New post</h1>
    <a href="/admin" class="text-caption font-bold text-link no-underline hover:underline">
      ← Posts
    </a>
  </div>
  <PostEditor
    client:load
    seminarSequence={seminarSequence}
    siteOrigin={Astro.url.origin}
    csrfToken={csrfToken}
  />
</AdminLayout>
