---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSessionUid } from '../../lib/auth';

// 이미 로그인 상태면 대시보드로.
if (await getSessionUid(Astro.request)) return Astro.redirect('/admin');
---

<AdminLayout title="Sign in">
  <div class="mx-auto max-w-sm">
    <h1 class="mb-6 font-serif text-display-sm font-semibold text-ink">Sign in</h1>
    <form id="login-form" class="space-y-4">
      <label class="block">
        <span class="mb-1 block text-caption text-body-muted">Username</span>
        <input
          name="username"
          required
          autocomplete="username"
          class="w-full border border-hairline-strong bg-canvas px-3 py-2 text-body-sm text-ink focus:border-accent focus:outline-none"
        />
      </label>
      <label class="block">
        <span class="mb-1 block text-caption text-body-muted">Password</span>
        <input
          name="password"
          type="password"
          required
          autocomplete="current-password"
          class="w-full border border-hairline-strong bg-canvas px-3 py-2 text-body-sm text-ink focus:border-accent focus:outline-none"
        />
      </label>
      <p id="login-error" role="alert" aria-live="polite" class="hidden text-caption text-accent">
        Invalid username or password.
      </p>
      <button
        type="submit"
        class="w-full bg-ink px-4 py-2 font-sans text-body-sm font-bold text-on-primary hover:opacity-90"
      >Sign in</button>
    </form>
  </div>
  <script>
    const form = document.getElementById('login-form') as HTMLFormElement | null;
    const errorEl = document.getElementById('login-error');
    const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorEl?.classList.add('hidden');
      if (submit) submit.disabled = true;
      try {
        const data = new FormData(form);
        const response = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ username: data.get('username'), password: data.get('password') }),
        });
        if (response.ok) {
          window.location.href = '/admin';
          return;
        }
        if (errorEl) {
          errorEl.textContent =
            response.status === 429
              ? 'Too many sign-in attempts. Wait 15 minutes and try again.'
              : 'Invalid username or password.';
          errorEl.classList.remove('hidden');
        }
      } catch {
        if (errorEl) {
          errorEl.textContent = 'Network unavailable. Check your connection and try again.';
          errorEl.classList.remove('hidden');
        }
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  </script>
</AdminLayout>
