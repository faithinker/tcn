---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import LoginForm from '../../components/membership/LoginForm.astro';
import { getSessionUid } from '../../lib/auth';
import {
  isLoginChallengeBypassed,
  type LoginChallengeBindings,
} from '../../lib/auth/login-challenge';
import { safeAdminReturnTo } from '../../lib/admin-api';
import { memberFeaturesEnabled } from '../../lib/member-features';
const returnTo = safeAdminReturnTo(Astro.url.searchParams.get('returnTo'));
if (memberFeaturesEnabled())
  return Astro.redirect(`/login?returnTo=${encodeURIComponent(returnTo)}`);
if (await getSessionUid(Astro.request)) return Astro.redirect(returnTo);
const bindings = env as unknown as LoginChallengeBindings & { TURNSTILE_SITE_KEY?: string };
const challengeBypassed = isLoginChallengeBypassed(bindings, Astro.url);
const siteKey = bindings.TURNSTILE_SITE_KEY ?? '';
const challengeUnavailable = !challengeBypassed && !siteKey;
---

<AdminLayout title="Sign in">
  <LoginForm {returnTo} {challengeBypassed} {siteKey} {challengeUnavailable} />
</AdminLayout>
