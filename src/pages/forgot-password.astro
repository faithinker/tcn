---
export const prerender = false;
import AccountShell from '../components/membership/AccountShell.astro';
import { memberFeaturesEnabled, memberFeatureUnavailable } from '../lib/member-features';
if (!memberFeaturesEnabled()) return memberFeatureUnavailable();
---

<AccountShell
  title="Reset your password"
  description="We will email you a secure link to set a new password."
>
  <nav slot="navigation" aria-label="Account navigation">
    <a href="/login">Back to sign in</a>
    <a href="/contact">Contact the Secretariat</a>
  </nav>
  <section class="account-section">
    <h2>Find your account</h2>
    <p class="account-lead">Enter the verified email you used to create your account.</p>
    <form
      id="recovery-form"
      class="account-form"
      method="post"
      action="/api/auth/forgot-password"
      data-mode="request"
    >
      <div class="account-field">
        <label class="account-label" for="recovery-email">
          Email address
        </label>
        <input
          id="recovery-email"
          name="email"
          type="email"
          class="account-input"
          required
          maxlength="254"
          autocomplete="email"
        />
      </div>
      <p data-form-error class="account-error" role="alert" tabindex="-1" hidden></p>
      <button class="account-button" type="submit">
        Send reset link
      </button>
    </form>
    <p id="recovery-success" class="account-notice mt-5" role="status" hidden>
      If there is an eligible account for this email, we have sent a reset link. Check your inbox
      and spam folder. The link expires in 30 minutes.
    </p>
    <p class="account-help mt-6">
      Using a manually issued username, an unverified email, or no longer have access to your inbox?
      Contact the Secretariat for account recovery.
    </p>
  </section>
  <script>
    import '../scripts/recovery';
  </script>
</AccountShell>
