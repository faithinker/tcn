---
interface Props {
  variant?: 'canvas' | 'band' | 'soft';
  eyebrow?: string;
  title?: string;
  id?: string;
  class?: string;
}

const { variant = 'canvas', eyebrow, title, id, class: cls = '' } = Astro.props;

const bg: Record<NonNullable<Props['variant']>, string> = {
  canvas: 'bg-canvas',
  band: 'bg-canvas-band',
  soft: 'bg-canvas-soft',
};
---

<section id={id} class={`${bg[variant]} px-5 py-12 sm:py-24 ${cls}`.trim()}>
  <div class="mx-auto max-w-[75rem]">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    {
      title && (
        <h2 class="mt-3 font-serif text-display-md font-semibold text-ink sm:text-display-lg">
          {title}
        </h2>
      )
    }
    <slot />
  </div>
</section>
