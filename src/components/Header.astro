---
import { t } from '../i18n/ui';
import { navItems } from '../lib/navigation';
import ThemeToggle from './ThemeToggle.astro';

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const desktopNavItems = navItems.filter((item) => item.key !== 'nav.contact');
const isActive = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  if (href === '/') return here === target;
  return here === target || here.startsWith(`${target}/`);
};
const isExact = (href: string) => {
  if (href.includes('#')) return false;
  const target = href.replace(/\/$/, '') || '/';
  return here === target;
};
---

<header
  class="sticky top-0 z-50 border-b border-hairline-strong bg-canvas pt-[env(safe-area-inset-top)]"
>
  <div
    class="mx-auto flex max-w-[75rem] items-center justify-between gap-2 px-4 py-3 min-[72rem]:gap-4 min-[72rem]:px-5"
  >
    <a
      href="/"
      class="flex shrink-0 items-baseline gap-1.5 whitespace-nowrap no-underline min-[72rem]:gap-2"
    >
      <span
        class="hidden font-serif text-[1.125rem] font-semibold text-ink sm:inline min-[72rem]:text-[1.375rem]"
        >{t('site.name')}</span
      >
      <span class="font-serif text-[1.125rem] font-semibold text-ink sm:hidden">TCN</span>
      <span
        class="hidden font-sans text-body-sm font-bold uppercase tracking-widest text-body-muted min-[72rem]:inline"
        >TCN</span
      >
    </a>

    <nav
      class="order-3 hidden min-w-0 items-center gap-0.5 min-[56rem]:flex min-[72rem]:gap-1"
      aria-label={t('common.menu')}
    >
      {
        desktopNavItems.map((item) =>
          item.children ? (
            <details class="group relative">
              <summary
                aria-current={
                  isExact(item.href) ? 'page' : isActive(item.href) ? 'location' : undefined
                }
                class="nav-summary flex min-h-[48px] cursor-pointer list-none items-center gap-1 whitespace-nowrap px-2 font-sans text-body-sm font-bold text-ink hover:text-link group-open:text-link aria-[current]:text-link min-[72rem]:gap-1.5 min-[72rem]:px-3 min-[72rem]:text-body-sans"
              >
                {t(item.key)}
                <svg
                  aria-hidden="true"
                  class="h-4 w-4 shrink-0 min-[72rem]:h-[18px] min-[72rem]:w-[18px]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.25"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <div class="absolute left-0 top-full min-w-48 border border-hairline-strong bg-canvas p-2 shadow-overlay">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    aria-current={isExact(child.href) ? 'page' : undefined}
                    class="flex min-h-[44px] items-center whitespace-nowrap px-3 font-sans text-body-sm font-bold text-ink no-underline hover:bg-canvas-soft aria-[current]:text-link"
                  >
                    {t(child.key)}
                  </a>
                ))}
              </div>
            </details>
          ) : (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="flex min-h-[48px] items-center whitespace-nowrap px-2 font-sans text-body-sm font-bold text-ink no-underline hover:text-link aria-[current]:text-link min-[72rem]:px-3 min-[72rem]:text-body-sans"
            >
              {t(item.key)}
            </a>
          ),
        )
      }
      <a
        href="/contact"
        class="ml-1 inline-flex min-h-[48px] items-center whitespace-nowrap rounded-sm bg-ink px-3 font-sans text-body-sm font-bold text-on-primary no-underline hover:bg-ink-soft min-[72rem]:ml-2 min-[72rem]:px-5 min-[72rem]:text-button"
      >
        {t('nav.cta')}
      </a>
    </nav>

    <div class="order-2 ml-auto flex shrink-0 items-center gap-1 sm:gap-2">
      <ThemeToggle />

      <button
        id="navToggle"
        type="button"
        class="flex h-12 w-12 shrink-0 items-center justify-center text-ink min-[56rem]:hidden"
        aria-expanded="false"
        aria-controls="mobileNav"
        aria-label={t('common.menu')}
      >
        <svg
          width="26"
          height="26"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobileNav"
    class="max-h-[calc(100dvh-73px)] overflow-y-auto overscroll-contain border-t border-hairline bg-canvas min-[56rem]:hidden"
    aria-label={t('common.menu')}
    hidden
  >
    <ul class="mx-auto max-w-[75rem] px-2 py-2">
      {
        navItems.map((item) => (
          <li>
            {item.children ? (
              <div class="border-b border-hairline py-2">
                <p
                  aria-current={
                    isExact(item.href) ? 'page' : isActive(item.href) ? 'location' : undefined
                  }
                  class="px-3 py-2 font-sans text-caption font-bold uppercase text-body-muted aria-[current]:text-link"
                >
                  {t(item.key)}
                </p>
                <ul class="border-l border-hairline ml-3">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        aria-current={isExact(child.href) ? 'page' : undefined}
                        class="flex min-h-[44px] items-center px-4 font-sans text-body-sans font-bold text-ink no-underline aria-[current]:text-link"
                      >
                        {t(child.key)}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="flex min-h-[48px] items-center px-3 font-sans text-body-sans font-bold text-ink no-underline aria-[current]:text-link"
              >
                {t(item.key)}
              </a>
            )}
          </li>
        ))
      }
      <li class="px-3 py-2">
        <a
          href="/contact"
          class="inline-flex min-h-[48px] w-full items-center justify-center rounded-sm bg-ink px-5 font-sans text-button font-bold text-on-primary no-underline"
        >
          {t('nav.cta')}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('navToggle');
  const menu = document.getElementById('mobileNav');

  const isOpen = () => btn?.getAttribute('aria-expanded') === 'true';
  let openScrollY = 0;

  const setMenuOpen = (open: boolean) => {
    if (!(btn instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;
    btn.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    if (open) openScrollY = window.scrollY;
  };

  btn?.addEventListener('click', () => {
    setMenuOpen(!isOpen());
  });

  menu?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) setMenuOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isOpen()) {
      setMenuOpen(false);
      btn?.focus();
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 896) setMenuOpen(false);
  });

  // 표준 UX: 헤더에 붙은 드롭다운 메뉴는 페이지 스크롤 시 닫는다.
  // 오픈 지점 대비 4px 초과 이동 시에만 닫아, 모바일 URL바 접힘·바운스가
  // 유발하는 미세 스크롤로 메뉴가 열리자마자 닫히는 것을 막는다.
  window.addEventListener(
    'scroll',
    () => {
      if (isOpen() && Math.abs(window.scrollY - openScrollY) > 4) setMenuOpen(false);
    },
    { passive: true },
  );
</script>

<style>
  .nav-summary {
    list-style: none;
  }

  .nav-summary::-webkit-details-marker {
    display: none;
  }

  .nav-summary::marker {
    content: '';
  }
</style>
