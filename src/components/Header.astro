---
import { t } from '../i18n/ui';
import { navItems } from '../lib/navigation';
import ThemeToggle from './ThemeToggle.astro';

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const desktopNavItems = navItems;
const isActive = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  if (href === '/') return here === target;
  return here === target || here.startsWith(`${target}/`);
};
const isExact = (href: string) => {
  if (href.includes('#')) return false;
  const target = href.replace(/\/$/, '') || '/';
  return here === target;
};
const isGroupActive = (item: (typeof navItems)[number]) =>
  isActive(item.href) || item.children?.some((child) => isActive(child.href));
---

<header class="sticky top-0 z-50 border-b border-hairline-strong bg-canvas pt-[env(safe-area-inset-top)]">
  <div class="mx-auto flex max-w-[75rem] items-center justify-between gap-2 px-4 py-3 min-[72rem]:gap-4 min-[72rem]:px-5">
    <a
      href="/"
      class="flex shrink-0 items-baseline gap-1.5 whitespace-nowrap no-underline min-[72rem]:gap-2"
    >
      <span class="hidden font-serif text-[1.125rem] font-semibold text-ink sm:inline min-[72rem]:text-[1.375rem]">
        {t('site.name')}
      </span>
      <span class="font-serif text-[1.125rem] font-semibold text-ink sm:hidden">TCN</span>
      <span class="hidden font-sans text-body-sm font-bold uppercase tracking-widest text-body-muted min-[72rem]:inline">
        TCN
      </span>
    </a>

    <nav
      class="-mb-[13px] -mt-3 hidden min-h-[73px] min-w-0 items-stretch gap-0.5 min-[56rem]:ml-auto min-[56rem]:flex min-[72rem]:gap-1"
      aria-label="Primary"
    >
      {desktopNavItems.map((item) =>
        item.children ? (
          <details
            class="desktop-nav-dropdown group relative min-h-[73px]"
            data-nav-dropdown
            data-board-menu={item.key === 'nav.boards' || undefined}
          >
            <summary
              aria-current={
                isExact(item.href) ? 'page' : isGroupActive(item) ? 'location' : undefined
              }
              class="desktop-nav-item nav-summary flex min-h-[73px] cursor-pointer list-none items-center justify-center gap-1 whitespace-nowrap border-b-2 border-transparent px-2 font-sans text-body-sm font-bold text-ink transition-colors min-[72rem]:gap-1.5 min-[72rem]:px-3 min-[72rem]:text-body-sans"
            >
              {t(item.key)}
              <svg
                aria-hidden="true"
                class="h-4 w-4 shrink-0 min-[72rem]:h-[18px] min-[72rem]:w-[18px]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.25"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="absolute left-0 top-full min-w-48 border border-hairline-strong bg-canvas p-2 shadow-overlay">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  data-board-link={item.key === 'nav.boards' ? child.href : undefined}
                  hidden={item.key === 'nav.boards' && child.href !== '/questions'}
                  aria-current={isExact(child.href) ? 'page' : undefined}
                  class:list={[
                    'flex min-h-[44px] items-center whitespace-nowrap px-3 font-sans text-body-sm font-bold text-ink no-underline hover:bg-canvas-soft aria-[current]:text-link',
                    { 'mt-2 border-t border-hairline pt-2': child.key === 'nav.contact' },
                  ]}
                >
                  {t(child.key)}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class="desktop-nav-item flex min-h-[73px] items-center justify-center whitespace-nowrap border-b-2 border-transparent px-2 font-sans text-body-sm font-bold text-ink no-underline transition-colors min-[72rem]:px-3 min-[72rem]:text-body-sans"
          >
            {t(item.key)}
          </a>
        ),
      )}
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-1 sm:gap-2 min-[56rem]:ml-0">
      <div class="flex items-center gap-1" role="group" aria-label="Account">
        <a
          href="/login"
          data-header-sign-in
          class="inline-flex min-h-11 items-center justify-center whitespace-nowrap rounded-sm bg-ink px-3 font-sans text-body-sm font-bold text-on-primary no-underline hover:bg-ink-soft min-[72rem]:px-4"
        >
          {t('nav.signIn')}
        </a>
        <a
          href="/account"
          data-header-profile
          aria-label={t('nav.profile')}
          title={t('nav.profile')}
          class="inline-flex size-11 shrink-0 items-center justify-center rounded-sm text-ink no-underline hover:bg-canvas-soft"
          hidden
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21v-2a8 8 0 0 1 16 0v2" />
          </svg>
        </a>
        <button
          type="button"
          data-header-logout
          title="Log out on all devices"
          class="inline-flex min-h-11 items-center justify-center whitespace-nowrap rounded-sm px-2 font-sans text-body-sm font-bold text-ink hover:bg-canvas-soft disabled:cursor-wait disabled:opacity-60 min-[72rem]:px-3"
          hidden
        >
          {t('nav.logOut')}
        </button>
      </div>
      <ThemeToggle />

      <button
        id="navToggle"
        type="button"
        class="flex h-12 w-12 shrink-0 items-center justify-center text-ink min-[56rem]:hidden"
        aria-expanded="false"
        aria-controls="mobileNav"
        aria-label={t('common.menu')}
      >
        <svg
          width="26"
          height="26"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <p
    data-header-auth-error
    role="alert"
    class="border-t border-hairline bg-canvas px-4 py-2 font-sans text-body-sm text-danger"
    hidden
  ></p>

  <nav
    id="mobileNav"
    class="max-h-[calc(100dvh-73px-env(safe-area-inset-top))] overflow-y-auto overscroll-contain border-t border-hairline bg-canvas min-[56rem]:hidden"
    aria-label="Primary (mobile)"
    hidden
  >
    <ul class="mx-auto max-w-[75rem] px-2 py-2">
      {navItems.map((item) => (
        <li>
          {item.children ? (
            <div class="border-b border-hairline py-2">
              <p
                aria-current={
                  isExact(item.href) ? 'page' : isGroupActive(item) ? 'location' : undefined
                }
                class="px-3 py-2 font-sans text-caption font-bold uppercase text-body-muted aria-[current]:text-link"
              >
                {t(item.key)}
              </p>
              <ul class="border-l border-hairline ml-3">
                {item.children.map((child) => (
                  <li
                    class:list={{
                      'mt-2 border-t border-hairline pt-2': child.key === 'nav.contact',
                    }}
                  >
                    <a
                      href={child.href}
                      data-board-link={item.key === 'nav.boards' ? child.href : undefined}
                      hidden={item.key === 'nav.boards' && child.href !== '/questions'}
                      aria-current={isExact(child.href) ? 'page' : undefined}
                      class="flex min-h-[44px] items-center px-4 font-sans text-body-sans font-bold text-ink no-underline aria-[current]:text-link"
                    >
                      {t(child.key)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="flex min-h-[48px] items-center px-3 font-sans text-body-sans font-bold text-ink no-underline aria-[current]:text-link"
            >
              {t(item.key)}
            </a>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .desktop-nav-item:hover {
    border-bottom-color: var(--color-hairline-strong);
    background-image: linear-gradient(var(--color-canvas-soft), var(--color-canvas-soft));
    background-position: center;
    background-repeat: no-repeat;
    background-size: 100% 48px;
    color: var(--color-ink);
  }

  .desktop-nav-item[aria-current],
  .desktop-nav-item[aria-current]:hover,
  .desktop-nav-dropdown[open] > .desktop-nav-item,
  .desktop-nav-dropdown[open] > .desktop-nav-item:hover {
    border-bottom-color: var(--color-accent);
    color: var(--color-link);
  }
</style>

<script>
  import '../scripts/member-navigation';
  const btn = document.getElementById('navToggle');
  const menu = document.getElementById('mobileNav');

  const isOpen = () => btn?.getAttribute('aria-expanded') === 'true';
  let openScrollY = 0;

  // 데스크톱 드롭다운(<details>)은 네이티브로는 요약을 다시 눌러야만 닫힌다.
  // 헤더 메뉴의 표준 해제 동작(바깥 클릭·ESC·스크롤·포커스 이탈)을 여기서 채운다.
  const dropdowns = Array.from(
    document.querySelectorAll<HTMLDetailsElement>('details[data-nav-dropdown]'),
  );
  // 스크롤 임계값. 모바일 메뉴(4px)보다 크게 잡아 트랙패드 관성 스크롤의
  // 잔여 이동으로 메뉴가 열리자마자 닫히는 것을 막는다.
  const DROPDOWN_SCROLL_TOLERANCE = 24;
  let dropdownScrollY = 0;
  const pinnedDropdowns = new WeakSet<HTMLDetailsElement>();

  const openDropdown = () => dropdowns.find((item) => item.open);

  const closeDropdowns = (except?: HTMLDetailsElement) => {
    for (const item of dropdowns) {
      if (item === except || !item.open) continue;
      // 패널 안에 포커스가 있는 채로 닫으면 포커스가 body 로 유실된다 — 요약으로 되돌린다.
      if (item.contains(document.activeElement)) item.querySelector('summary')?.focus();
      pinnedDropdowns.delete(item);
      item.open = false;
    }
  };

  for (const dropdown of dropdowns) {
    dropdown.addEventListener('toggle', () => {
      if (!dropdown.open) {
        pinnedDropdowns.delete(dropdown);
        return;
      }
      dropdownScrollY = window.scrollY;
      closeDropdowns(dropdown);
    });

    if (dropdown.hasAttribute('data-board-menu')) {
      dropdown.addEventListener('pointerenter', (event) => {
        if (event.pointerType !== 'mouse' || !matchMedia('(hover: hover)').matches) return;
        closeDropdowns(dropdown);
        dropdownScrollY = window.scrollY;
        dropdown.open = true;
      });
      dropdown.addEventListener('pointerleave', () => {
        if (pinnedDropdowns.has(dropdown)) return;
        // A keyboard user may still be working inside the panel.
        if (dropdown.querySelector('div')?.contains(document.activeElement)) return;
        dropdown.open = false;
      });
      dropdown.querySelector('summary')?.addEventListener('click', (event) => {
        event.preventDefault();
        if (pinnedDropdowns.has(dropdown)) {
          pinnedDropdowns.delete(dropdown);
          dropdown.open = false;
        } else {
          closeDropdowns(dropdown);
          pinnedDropdowns.add(dropdown);
          dropdownScrollY = window.scrollY;
          dropdown.open = true;
        }
      });
    }

    // 키보드로 마지막 항목을 지나 Tab 하면 닫는다.
    // relatedTarget이 없으면 창 자체가 포커스를 잃은 경우라 유지한다.
    dropdown.addEventListener('focusout', (event) => {
      const next = event.relatedTarget;
      if (!(next instanceof Node) || dropdown.contains(next)) return;
      pinnedDropdowns.delete(dropdown);
      dropdown.open = false;
    });
  }

  // click이 아니라 pointerdown으로 잡아, 바깥을 누르는 순간 닫히게 한다.
  document.addEventListener('pointerdown', (event) => {
    const current = openDropdown();
    if (!current) return;
    if (event.target instanceof Node && current.contains(event.target)) return;
    closeDropdowns();
  });

  const setMenuOpen = (open: boolean) => {
    if (!(btn instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;
    btn.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    if (open) openScrollY = window.scrollY;
  };

  btn?.addEventListener('click', () => {
    setMenuOpen(!isOpen());
  });

  menu?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) setMenuOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;

    const current = openDropdown();
    if (current) {
      current.open = false;
      current.querySelector('summary')?.focus();
      return;
    }

    if (isOpen()) {
      setMenuOpen(false);
      btn?.focus();
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 896) setMenuOpen(false);
    else closeDropdowns();
  });

  // 헤더 드롭다운은 스크롤 시 닫되, 오픈 지점 대비 4px 초과 이동에만 닫아 모바일 URL바 접힘의 미세 스크롤로 닫히지 않게 한다.
  window.addEventListener(
    'scroll',
    () => {
      if (isOpen() && Math.abs(window.scrollY - openScrollY) > 4) setMenuOpen(false);
      const current = openDropdown();
      const tolerance = current?.hasAttribute('data-board-menu') ? 0 : DROPDOWN_SCROLL_TOLERANCE;
      if (current && Math.abs(window.scrollY - dropdownScrollY) > tolerance) closeDropdowns();
    },
    { passive: true },
  );
</script>

<style>
  .nav-summary {
    list-style: none;
  }

  .nav-summary::-webkit-details-marker {
    display: none;
  }

  .nav-summary::marker {
    content: '';
  }
</style>
