---
// 네이티브 <dialog> 가 포커스 트랩·Esc·backdrop 을 담당한다.
// 트리거는 [data-lightbox-open="<id>"], 항목 데이터는 JSON 스크립트로 전달한다.
import { content } from '../../i18n/content';
import { serializeLightboxEntries, type LightboxEntry } from '../../lib/media/lightbox';

interface Props {
  id: string;
  entries: LightboxEntry[];
}

const { id, entries } = Astro.props;
const copy = content.mediaViewer;
const single = entries.length < 2;
---

{/* is:inline — 번들링 대상이 아닌 데이터 블록이다(JS 아님). */}
<script
  is:inline
  type="application/json"
  data-lightbox-manifest={id}
  set:html={serializeLightboxEntries(entries)}
/>

<dialog class="media-lightbox" data-lightbox-root={id} aria-label={copy.viewerLabel}>
  <div class="lb-shell">
    <div class="lb-stage" data-lb-stage></div>

    <div class="lb-bar">
      <p class="lb-caption" data-lb-caption></p>
      <p class="lb-meta" data-lb-meta></p>
      <div class="lb-controls">
        {
          !single && (
            <>
              <button type="button" data-lb-prev aria-label={copy.previous}>
                ←
              </button>
              <span class="lb-count" data-lb-count aria-hidden="true" />
              <button type="button" data-lb-next aria-label={copy.next}>
                →
              </button>
            </>
          )
        }
        <button type="button" data-lb-close>{copy.close}</button>
      </div>
    </div>
  </div>
  <p class="sr-only" aria-live="polite" data-lb-live></p>
</dialog>

<!-- is:global 필수 — 스테이지의 img/video 는 스크립트가 런타임에 만들어서
     Astro 스코프 속성(data-astro-cid-*)이 없다. 스코프 스타일이면 선택자가 빗나가
     맞춤(fit) 제약이 걸리지 않고 이미지가 화면을 넘친다. 선택자는 .media-lightbox 로 한정. -->
<style is:global>
  .media-lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: 100vw;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
    color: var(--color-on-footer);
  }
  .media-lightbox::backdrop {
    background: color-mix(in srgb, var(--color-footer) 96%, transparent);
  }
  .lb-shell {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    width: 100%;
    min-width: 0;
    height: 100%;
  }
  .lb-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .lb-stage img {
    width: auto;
    height: auto;
    max-width: 94vw;
    max-height: 100%;
  }
  .lb-stage video {
    max-width: 94vw;
    max-height: 100%;
  }
  .lb-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.15rem;
    width: 100%;
    min-width: 0;
    padding: 0.85rem 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-on-footer) 14%, transparent);
    background: color-mix(in srgb, var(--color-footer) 88%, transparent);
    font-family: var(--font-sans);
  }
  .lb-caption {
    flex: 1 1 20rem;
    min-width: 0;
    font-size: var(--text-caption);
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-on-footer) 80%, transparent);
  }
  .lb-meta {
    font-size: var(--text-caption);
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-on-footer) 60%, transparent);
  }
  .lb-controls {
    display: flex;
    flex-shrink: 0;
    min-width: 0;
    gap: 0.4rem;
    align-items: center;
  }
  .lb-controls button {
    min-height: 3rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-on-footer) 35%, transparent);
    background: transparent;
    color: var(--color-on-footer);
    font-family: inherit;
    font-size: var(--text-caption);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }
  .lb-controls button:hover {
    border-color: var(--color-on-footer);
    background: color-mix(in srgb, var(--color-on-footer) 8%, transparent);
  }
  .lb-controls button:focus-visible {
    outline: 2px solid var(--color-on-footer);
    outline-offset: 2px;
  }
  .lb-count {
    padding: 0 0.15rem;
    font-size: var(--text-caption);
    color: color-mix(in srgb, var(--color-on-footer) 60%, transparent);
    font-variant-numeric: tabular-nums;
  }
  /* 좁은 화면에서는 캡션을 두 줄로 제한하고 탐색 컨트롤을 한 줄로 유지한다. */
  @media (max-width: 30rem) {
    .media-lightbox .lb-bar {
      gap: 0.5rem 0.75rem;
      padding: 0.7rem 0.9rem;
    }
    .media-lightbox .lb-meta {
      display: none;
    }
    .media-lightbox .lb-caption {
      flex-basis: 100%;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .media-lightbox .lb-controls {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) minmax(0, 1fr);
      flex: 1 1 100%;
      width: 100%;
      gap: 0.4rem;
    }
    .media-lightbox .lb-controls button {
      width: 100%;
      min-width: 0;
      padding-inline: 0.45rem;
      text-align: center;
    }
    .media-lightbox [data-lb-prev] {
      grid-column: 1;
      grid-row: 1;
    }
    .media-lightbox .lb-count {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
      justify-self: center;
    }
    .media-lightbox [data-lb-next] {
      grid-column: 3;
      grid-row: 1;
    }
    .media-lightbox [data-lb-close] {
      grid-column: 4;
      grid-row: 1;
    }
  }
</style>

<script>
  interface Entry {
    id: string;
    type: 'image' | 'video';
    caption: string;
    alt: string;
    src: string;
    duration?: string;
  }

  document.querySelectorAll<HTMLDialogElement>('[data-lightbox-root]').forEach((dialog) => {
    const id = dialog.dataset.lightboxRoot!;
    const manifest = [...document.querySelectorAll<HTMLElement>('[data-lightbox-manifest]')].find(
      (node) => node.dataset.lightboxManifest === id,
    );
    if (!manifest?.textContent) return;

    const entries: Entry[] = JSON.parse(manifest.textContent);
    const stage = dialog.querySelector<HTMLElement>('[data-lb-stage]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const meta = dialog.querySelector<HTMLElement>('[data-lb-meta]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]');
    const live = dialog.querySelector<HTMLElement>('[data-lb-live]')!;

    let index = 0;

    function render(next: number) {
      index = (next + entries.length) % entries.length;
      const entry = entries[index];
      stage.querySelectorAll('img, video').forEach((node) => {
        if (node instanceof HTMLVideoElement) node.pause();
        node.remove();
      });

      if (entry.type === 'video') {
        const video = document.createElement('video');
        video.src = entry.src;
        video.controls = true;
        video.playsInline = true;
        video.preload = 'metadata';
        video.setAttribute('aria-label', entry.alt);
        stage.appendChild(video);
        meta.textContent = entry.duration ?? '';
      } else {
        const img = document.createElement('img');
        img.src = entry.src;
        img.alt = entry.alt;
        stage.appendChild(img);
        meta.textContent = '';
      }

      caption.textContent = entry.caption;
      if (count) count.textContent = `${index + 1} / ${entries.length}`;
      live.textContent = `${index + 1} / ${entries.length}. ${entry.caption}`;
    }

    function open(next: number) {
      render(next);
      if (!dialog.open) dialog.showModal();
    }

    document.querySelectorAll<HTMLElement>('[data-lightbox-open]').forEach((trigger) => {
      if (trigger.dataset.lightboxOpen !== id) return;
      trigger.addEventListener('click', () => open(Number(trigger.dataset.lightboxIndex ?? 0)));
    });

    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')?.addEventListener('click', () => render(index - 1));
    dialog.querySelector('[data-lb-next]')?.addEventListener('click', () => render(index + 1));

    dialog.addEventListener('close', () => {
      stage.querySelectorAll('img, video').forEach((node) => {
        if (node instanceof HTMLVideoElement) node.pause();
        node.remove();
      });
    });

    dialog.addEventListener('mousedown', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        if (entries.length > 1) render(index - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        if (entries.length > 1) render(index + 1);
      }
    });
  });
</script>
