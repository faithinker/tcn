---
interface Props {
  id: string;
  name: string;
  label: string;
  autocomplete?: string;
  help?: string;
  isNew?: boolean;
}
const { id, name, label, autocomplete = 'new-password', help, isNew = false } = Astro.props;
---

<div class="account-field">
  <label class="account-label" for={id}>
    {label}
  </label>
  <div class="account-password">
    <input
      class="account-input"
      type="password"
      {id}
      {name}
      autocomplete={autocomplete}
      required
      aria-describedby={help ? `${id}-help` : undefined}
      data-new-password={isNew || undefined}
    />
    <button
      type="button"
      data-password-toggle={id}
      aria-controls={id}
      aria-pressed="false"
      aria-label={`Show ${label.toLowerCase()}`}
    >
      Show
    </button>
  </div>
  {help && (
    <p id={`${id}-help`} class="account-help">
      {help}
    </p>
  )}
  <p data-caps-lock={id} class="account-help" hidden>
    Caps Lock is on.
  </p>
</div>

<script>
  import '../../scripts/account-common';
</script>
