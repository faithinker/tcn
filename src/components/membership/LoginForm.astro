---
import PasswordField from './PasswordField.astro';
import '../../styles/account.css';
import { LOGIN_CHALLENGE_ACTION } from '../../lib/auth/login-challenge';
import { CHALLENGE_CALLBACKS } from '../../scripts/challenge-gate';
interface Props {
  returnTo?: string | null;
  challengeBypassed: boolean;
  siteKey: string;
  challengeUnavailable: boolean;
}
const { returnTo, challengeBypassed, siteKey, challengeUnavailable } = Astro.props;
---

<div data-return-to={returnTo}>
  <h2 class="text-xl font-bold text-ink">Welcome back</h2>
  <p class="account-lead">Sign in to your TCN account.</p>
  <p id="login-notice" class="account-notice mt-5" role="status" hidden></p>
  <form
    id="login-form"
    method="post"
    action="/api/auth/login"
    class="account-form"
    data-challenge={!challengeBypassed && siteKey ? 'on' : 'off'}
  >
    <div class="account-field">
      <label for="login-username" class="account-label">
        Email or username
      </label>
      <input
        id="login-username"
        name="username"
        required
        spellcheck="false"
        autocomplete="username"
        autocapitalize="none"
        class="account-input"
      />
    </div>
    <PasswordField
      id="login-password"
      name="password"
      label="Password"
      autocomplete="current-password"
    />
    {!challengeBypassed && siteKey && (
      <div
        class="cf-turnstile"
        data-sitekey={siteKey}
        data-action={LOGIN_CHALLENGE_ACTION}
        data-appearance="interaction-only"
        data-callback={CHALLENGE_CALLBACKS.success}
        data-expired-callback={CHALLENGE_CALLBACKS.expired}
        data-error-callback={CHALLENGE_CALLBACKS.error}
      />
    )}
    <p
      id="login-error"
      role="alert"
      aria-live="polite"
      class:list={['account-error', !challengeUnavailable && 'hidden']}
    >
      {challengeUnavailable
        ? 'Sign-in is temporarily unavailable. Please try again later.'
        : 'Invalid email or password.'}
    </p>
    <button
      type="submit"
      disabled={challengeUnavailable}
      data-locked={challengeUnavailable ? 'true' : undefined}
      class="account-button"
    >
      Sign in
    </button>
  </form>
  <a href="/forgot-password" class="account-text-button mt-4">
    Forgot your password?
  </a>
</div>
<script>
  import {
    CHALLENGE_FAILED_MESSAGE,
    createChallengeGate,
    setCheckingLabel,
  } from '../../scripts/challenge-gate';
  import { failureMessage } from '../../scripts/login-messages';

  const notice = document.getElementById('login-notice');
  const currentUrl = new URL(window.location.href);
  const noticeKind = currentUrl.searchParams.get('notice');
  if (notice && ['password-changed', 'password-reset'].includes(noticeKind ?? '')) {
    notice.textContent = 'Your password has been updated. Sign in with your new password.';
    notice.hidden = false;
  }
  if (noticeKind) {
    currentUrl.searchParams.delete('notice');
    history.replaceState(null, '', currentUrl.pathname + currentUrl.search + currentUrl.hash);
  }
  const form = document.getElementById('login-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('login-error');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  let submitting = false;

  // 위젯 토큰은 1회용이다. 제출을 시도할 때마다 게이트를 되돌려 새 토큰을 받는다.
  const gate = createChallengeGate({
    enabled: form?.dataset.challenge === 'on',
    widgetRoot: form ?? document,
    onChange: syncChallenge,
  });
  function showError(message: string): void {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
  }
  let failureShown = false;
  function syncChallenge(): void {
    if (!submit) return;
    const pending = gate.pending();
    submit.disabled = submitting || submit.dataset.locked === 'true' || pending;
    setCheckingLabel(submit, pending);
    if (!gate.failed()) {
      failureShown = false;
      if (errorEl?.textContent === CHALLENGE_FAILED_MESSAGE) errorEl.classList.add('hidden');
    } else if (!failureShown) {
      // 입력 중인 칸의 포커스를 빼앗지 않도록 안내만 띄운다.
      failureShown = true;
      showError(CHALLENGE_FAILED_MESSAGE);
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl?.classList.add('hidden');
    if (gate.pending()) return;
    if (gate.failed() && !gate.token()) {
      gate.reset();
      showError(CHALLENGE_FAILED_MESSAGE);
      return;
    }
    submitting = true;
    syncChallenge();
    if (submit) submit.textContent = 'Signing in…';
    try {
      const data = new FormData(form);
      const response = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          username: data.get('username'),
          password: data.get('password'),
          turnstileToken: gate.token(),
          returnTo: document.querySelector<HTMLElement>('[data-return-to]')?.dataset.returnTo,
        }),
      });
      if (response.ok) {
        const payload = (await response.json()) as { redirectTo?: string };
        window.location.href = payload.redirectTo || '/account';
        return;
      }
      showError(failureMessage(response.status, response.headers.get('retry-after')));
    } catch {
      showError('Network unavailable. Check your connection and try again.');
    } finally {
      submitting = false;
      gate.reset();
      syncChallenge();
    }
  });
  syncChallenge();
  if (form) form.dataset.ready = 'true';
</script>
{!challengeBypassed && siteKey && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
)}
