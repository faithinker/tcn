---
import PasswordField from './PasswordField.astro';
import '../../styles/account.css';
import { LOGIN_CHALLENGE_ACTION } from '../../lib/auth/login-challenge';
interface Props {
  returnTo?: string | null;
  challengeBypassed: boolean;
  siteKey: string;
  challengeUnavailable: boolean;
}
const { returnTo, challengeBypassed, siteKey, challengeUnavailable } = Astro.props;
---

<div data-return-to={returnTo}>
  <h2 class="text-xl font-bold text-ink">Welcome back</h2>
  <p class="account-lead">Sign in to your TCN account.</p>
  <p id="login-notice" class="account-notice mt-5" role="status" hidden></p>
  <form
    id="login-form"
    method="post"
    action="/api/auth/login"
    class="account-form"
    data-challenge={challengeBypassed ? 'off' : 'on'}
  >
    <div class="account-field">
      <label for="login-username" class="account-label">
        Email or username
      </label>
      <input
        id="login-username"
        name="username"
        required
        spellcheck="false"
        autocomplete="username"
        autocapitalize="none"
        class="account-input"
      />
    </div>
    <PasswordField
      id="login-password"
      name="password"
      label="Password"
      autocomplete="current-password"
    />
    {!challengeBypassed && siteKey && (
      <div
        class="cf-turnstile"
        data-sitekey={siteKey}
        data-action={LOGIN_CHALLENGE_ACTION}
        data-callback="onLoginTurnstileSuccess"
        data-expired-callback="onLoginTurnstileExpired"
        data-error-callback="onLoginTurnstileError"
      />
    )}
    <p
      id="login-error"
      role="alert"
      aria-live="polite"
      class:list={['account-error', !challengeUnavailable && 'hidden']}
    >
      {challengeUnavailable
        ? 'Sign-in is temporarily unavailable. Please try again later.'
        : 'Invalid email or password.'}
    </p>
    <button type="submit" disabled={challengeUnavailable} class="account-button">
      Sign in
    </button>
  </form>
  <a href="/forgot-password" class="account-text-button mt-4">
    Forgot your password?
  </a>
</div>
<script>
  import { CHALLENGE_PENDING_MESSAGE, failureMessage } from '../../scripts/login-messages';

  declare global {
    interface Window {
      onLoginTurnstileSuccess?: (token: string) => void;
      onLoginTurnstileExpired?: () => void;
      onLoginTurnstileError?: () => void;
      turnstile?: { reset: (widget?: string | HTMLElement) => void };
    }
  }

  const notice = document.getElementById('login-notice');
  const currentUrl = new URL(window.location.href);
  const noticeKind = currentUrl.searchParams.get('notice');
  if (notice && ['password-changed', 'password-reset'].includes(noticeKind ?? '')) {
    notice.textContent = 'Your password has been updated. Sign in with your new password.';
    notice.hidden = false;
  }
  if (noticeKind) {
    currentUrl.searchParams.delete('notice');
    history.replaceState(null, '', currentUrl.pathname + currentUrl.search + currentUrl.hash);
  }
  const form = document.getElementById('login-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('login-error');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const challengeOn = form?.dataset.challenge === 'on';

  // 위젯 토큰은 1회용이다. 제출을 시도할 때마다 비우고 위젯을 다시 돌려 새 토큰을 받는다.
  let turnstileToken = '';
  window.onLoginTurnstileSuccess = (token) => {
    turnstileToken = token;
  };
  window.onLoginTurnstileExpired = () => {
    turnstileToken = '';
  };
  window.onLoginTurnstileError = () => {
    turnstileToken = '';
  };
  function resetChallenge(): void {
    turnstileToken = '';
    const widget = document.querySelector<HTMLElement>('.cf-turnstile');
    if (widget) window.turnstile?.reset(widget);
  }
  function showError(message: string): void {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl?.classList.add('hidden');
    if (challengeOn && !turnstileToken) {
      showError(CHALLENGE_PENDING_MESSAGE);
      return;
    }
    if (submit) {
      submit.disabled = true;
      submit.textContent = 'Signing in…';
    }
    try {
      const data = new FormData(form);
      const response = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          username: data.get('username'),
          password: data.get('password'),
          turnstileToken,
          returnTo: document.querySelector<HTMLElement>('[data-return-to]')?.dataset.returnTo,
        }),
      });
      if (response.ok) {
        const payload = (await response.json()) as { redirectTo?: string };
        window.location.href = payload.redirectTo || '/account';
        return;
      }
      showError(failureMessage(response.status, response.headers.get('retry-after')));
    } catch {
      showError('Network unavailable. Check your connection and try again.');
    } finally {
      if (challengeOn) resetChallenge();
      if (submit) {
        submit.disabled = false;
        submit.textContent = 'Sign in';
      }
    }
  });
  if (form) form.dataset.ready = 'true';
</script>
{!challengeBypassed && siteKey && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
)}
