---
import { t } from '../i18n/ui';

const networkNav = [
  { key: 'nav.about', href: '/about' },
  { key: 'nav.people', href: '/people' },
  { key: 'nav.seminars', href: '/seminars' },
  { key: 'nav.questions', href: '/questions' },
] as const;

const governanceNav = [
  { key: 'nav.bylaws', href: '/about/bylaws' },
  { label: 'Privacy Policy', href: '/privacy' },
  { key: 'nav.contact', href: '/contact' },
] as const;

const year = 2026;
---

<footer class="border-t border-hairline-strong bg-footer text-on-footer pb-[env(safe-area-inset-bottom)]">
  <div class="mx-auto grid max-w-[75rem] grid-cols-1 gap-8 px-4 py-10 sm:grid-cols-2 sm:gap-x-8 sm:gap-y-10 sm:px-5 sm:py-16 lg:grid-cols-[1.4fr_0.9fr_0.9fr_1.3fr] lg:gap-x-10">
    <div>
      <p class="font-serif text-[1.375rem] font-semibold">{t('site.name')}</p>
      <p class="mt-4 max-w-[36ch] font-sans text-body-sm leading-relaxed text-on-footer/70">
        {t('site.tagline')}
      </p>
    </div>

    <nav aria-label="Network">
      <p class="font-sans text-body-sm font-bold uppercase tracking-widest text-on-footer/50">
        Network
      </p>
      <ul class="mt-3 space-y-1">
        {networkNav.map((item) => (
          <li>
            <a
              href={item.href}
              class="inline-flex min-h-[44px] items-center font-sans text-body-sans text-on-footer/90 no-underline hover:text-on-footer"
            >
              {t(item.key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Governance">
      <p class="font-sans text-body-sm font-bold uppercase tracking-widest text-on-footer/50">
        Governance
      </p>
      <ul class="mt-3 space-y-1">
        {governanceNav.map((item) => (
          <li>
            <a
              href={item.href}
              class="inline-flex min-h-[44px] items-center font-sans text-body-sans text-on-footer/90 no-underline hover:text-on-footer"
            >
              {'label' in item ? item.label : t(item.key)}
            </a>
          </li>
        ))}
      </ul>
      <nav aria-label="Member links" data-member-navigation="footer" class="mt-2" hidden></nav>
    </nav>

    <div>
      <p class="font-sans text-body-sm font-bold uppercase tracking-widest text-on-footer/50">
        {t('footer.office')}
      </p>
      <p class="mt-3 font-sans text-body-sm leading-relaxed text-on-footer/90">
        {t('footer.officeValue')}
      </p>
      <div class="mt-3 space-y-1.5 font-sans text-body-sm text-on-footer/90">
        <p class="flex items-center gap-2">
          <span class="font-semibold text-on-footer/60">Tel:</span>
          <a
            href="tel:031-709-8111"
            class="underline hover:text-on-footer hover:decoration-2"
          >
            031-709-8111
          </a>
        </p>
        <p class="flex items-center gap-2">
          <span class="font-semibold text-on-footer/60">Email:</span>
          <a
            href={`mailto:${t('footer.contactEmail')}`}
            class="break-all underline hover:text-on-footer hover:decoration-2"
          >
            {t('footer.contactEmail')}
          </a>
        </p>
      </div>
    </div>
  </div>

  <div class="border-t border-on-footer/15 py-4 font-sans text-caption leading-relaxed text-on-footer/75">
    <div class="mx-auto flex max-w-[75rem] flex-wrap items-center gap-x-3 gap-y-1 px-4 sm:px-5">
      <span class="font-semibold text-on-footer">Transcultural Network (초문화네트워크)</span>
      <span class="hidden text-on-footer/30 sm:inline" aria-hidden="true">|</span>
      <span>President: Wonjoon Kim (김원준)</span>
      <span class="hidden text-on-footer/30 sm:inline" aria-hidden="true">|</span>
      <span>Secretariat Tel: 031-709-8111</span>
      <span class="hidden text-on-footer/30 sm:inline" aria-hidden="true">|</span>
      <span>Address: 286, Gukhwa-ri, Ganghwa-eup, Ganghwa-gun, Incheon, Republic of Korea</span>
    </div>
  </div>

  <div class="border-t border-on-footer/10">
    <div class="mx-auto flex max-w-[75rem] flex-wrap items-center justify-between gap-x-6 gap-y-1 px-4 py-4 sm:px-5">
      <p class="font-sans text-caption text-on-footer/50">
        © {year} {t('footer.copyright')}. All rights reserved.
      </p>
      <a
        href="#main"
        class="inline-flex min-h-[32px] items-center gap-1 font-sans text-caption text-on-footer/60 no-underline hover:text-on-footer"
      >
        Back to top ↑
      </a>
    </div>
  </div>
</footer>
