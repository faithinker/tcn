---
import { t } from '../i18n/ui';

interface Props {
  current: 'declaration' | 'bylaws' | 'founding';
}

const { current } = Astro.props;
const documents = [
  { id: 'founding', label: t('nav.founding'), href: '/about/founding' },
  { id: 'declaration', label: t('nav.declaration'), href: '/about/declaration' },
  { id: 'bylaws', label: t('nav.bylaws'), href: '/about/bylaws' },
];
---

<nav
  class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-1 font-sans text-body-sm"
  aria-label={t('common.relatedDocuments')}
>
  <span class="font-bold text-ink">{t('common.relatedDocuments')}</span>
  {
    documents.map((document) => {
      const isCurrent = document.id === current;
      // 링크 어포던스는 밑줄이 담당한다. 파란색은 현재 위치 표시 전용(DESIGN.md 213-214).
      return (
        <a
          href={document.href}
          aria-current={isCurrent ? 'page' : undefined}
          class:list={[
            'inline-flex min-h-[44px] items-center font-bold',
            isCurrent ? 'text-accent no-underline' : 'text-ink underline hover:decoration-2',
          ]}
        >
          {document.label}
        </a>
      );
    })
  }
</nav>
