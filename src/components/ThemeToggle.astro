---
import { t } from '../i18n/ui';

const label = t('common.themeToggle');
---

<button
  id="themeToggle"
  type="button"
  aria-pressed="false"
  class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-sm border border-hairline-strong bg-canvas text-ink transition-colors hover:border-link hover:text-link focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
  aria-label={label}
>
  <svg
    class="moon-icon h-5 w-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.25"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
  <svg
    class="sun-icon h-5 w-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.25"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
</button>

<style>
  .sun-icon {
    display: none;
  }
  .moon-icon {
    display: block;
  }
  :global(html.dark) .sun-icon {
    display: block;
  }
  :global(html.dark) .moon-icon {
    display: none;
  }
</style>

<script>
  const toggle = document.getElementById('themeToggle');
  if (toggle) {
    const updateAriaPressed = () => {
      const isDark = document.documentElement.classList.contains('dark');
      toggle.setAttribute('aria-pressed', String(isDark));
    };

    updateAriaPressed();

    toggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      // 스토리지가 차단되어도 토글 자체는 동작해야 한다 — 기억만 못 한다.
      try {
        localStorage.setItem('tcn_theme', isDark ? 'dark' : 'light');
      } catch {
        /* 스토리지 차단: 이 세션에서만 유지된다 */
      }
      const themeMeta = document.querySelector('meta[name="theme-color"]');
      if (themeMeta) themeMeta.setAttribute('content', isDark ? '#181715' : '#ffffff');
      document.dispatchEvent(new CustomEvent('tcn:themechange', { detail: { isDark } }));
      updateAriaPressed();
    });
  }
</script>
