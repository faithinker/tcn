# Optional external application form. The CTA stays disabled when unset.
PUBLIC_MEMBERSHIP_FORM_URL=

# 세션 서명 비밀값 — 로컬은 .dev.vars, 원격은 `wrangler secret put SESSION_SECRET`.
# (콘텐츠는 wrangler.jsonc의 D1/R2 바인딩으로 접근 — 별도 URL/키 없음)
SESSION_SECRET=

# Public Q&A anti-abuse configuration. Keep secret values in .dev.vars locally and
# Worker secrets remotely. Hostnames is a comma-separated exact allowlist.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
QNA_TURNSTILE_HOSTNAMES=localhost
QNA_RATE_LIMIT_SECRET=
