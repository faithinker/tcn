# Optional external application form. The CTA stays disabled when unset.
PUBLIC_MEMBERSHIP_FORM_URL=

# Seminar content platform. Browser code may read only the PUBLIC_ values.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/CLI only. Never expose these through PUBLIC_ variables.
SUPABASE_SECRET_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_ID=

# Used only by trusted automation that dispatches existing GitHub Actions.
GITHUB_ACTIONS_TOKEN=
GITHUB_REPOSITORY=faithinker/tcn
GITHUB_DEPLOY_WORKFLOW=deploy-pages.yml
GITHUB_DEPLOY_REF=main

# Optional Edge Function overrides. Use either the Cloudflare hook or GitHub dispatch.
CLOUDFLARE_DEPLOY_HOOK_URL=
ALLOWED_ORIGINS=https://tcn-ezj.pages.dev,http://localhost:4321,http://127.0.0.1:4321
