# Optional external application form. The CTA stays disabled when unset.
PUBLIC_MEMBERSHIP_FORM_URL=

# 세션 서명 비밀값 — 로컬은 .dev.vars, 원격은 `wrangler secret put SESSION_SECRET`.
# (콘텐츠는 wrangler.jsonc의 D1/R2 바인딩으로 접근 — 별도 URL/키 없음)
SESSION_SECRET=

# Public Q&A anti-abuse configuration. Keep secret values in .dev.vars locally and
# Worker secrets remotely. Hostnames is a comma-separated exact allowlist.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
QNA_TURNSTILE_HOSTNAMES=localhost
QNA_RATE_LIMIT_SECRET=

# 관리자 로그인에는 Turnstile 챌린지가 필요하다(위 Q&A 와 같은 위젯·키, 위젯 action 만 다름).
# 로컬·CI 에서 헤드리스 브라우저 게이트(verify:admin)가 로그인 폼을 밟을 때만 `off` 로 둔다.
# 요청이 localhost 로 들어온 경우에만 효력이 있다 — 운영 Worker 에는 설정하지 않는다.
LOGIN_CHALLENGE=

# Only exact true opens member forums and user management. Verify the roster first.
MEMBER_FEATURES_ENABLED=false
# Separate public-signup gate; keep false until privacy and anti-abuse work is approved.
SIGNUP_ENABLED=false

# Account mail: Resend Free. Configure a verified sender; keep public signup off
# until the domain, privacy policy and recovery/withdrawal flows are verified.
# Secrets: .dev.vars locally, `wrangler secret put RESEND_API_KEY` remotely.
RESEND_API_KEY=
AUTH_MAIL_FROM=
AUTH_PUBLIC_ORIGIN=https://thetcn.org
# Local/CI only: local + loopback hostname stores synthetic mail in local D1.
# This never enables a public inbox or an email-verification bypass.
AUTH_MAIL_MODE=
